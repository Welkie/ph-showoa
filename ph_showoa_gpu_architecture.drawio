dth=1.2;fontSize=13;fontStyle=1;labelBackgroundColor=none;fontFamily=Times New Roman;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="best_out" target="end"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="start" value="Bắt đầu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=1.2;fontSize=14;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="50" y="70" width="80" height="44" as="geometry"/></mxCell><mxCell id="cpu_prep" value="&lt;b&gt;CPU_PREP&lt;/b&gt; (1 lần cho mọi run)&lt;br&gt;Đọc instance; nạp ma trận khoảng cách/thời gian, nhu cầu giao/nhận, cửa sổ thời gian lên VRAM&lt;br&gt;Cấp phát trước buffer: quần thể cur / next / cand [P×R×L], best đảo, gbest, scratch, RNG, log" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="45" width="560" height="92" as="geometry"/></mxCell><mxCell id="leg_new_sw" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;" vertex="1" parent="1"><mxGeometry x="800" y="52" width="34" height="18" as="geometry"/></mxCell><mxCell id="leg_new" value="Mới / thay đổi so với paper PH-SHOWOA" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="842" y="48" width="430" height="26" as="geometry"/></mxCell><mxCell id="leg_old_sw" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="800" y="82" width="34" height="18" as="geometry"/></mxCell><mxCell id="leg_old" value="Giữ như paper (Alg. 1)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="842" y="78" width="430" height="26" as="geometry"/></mxCell><mxCell id="leg_cost" value="Cost = 2000·NV + TD (dùng cho chọn lọc, chấp nhận và cập nhật best)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="800" y="108" width="470" height="26" as="geometry"/></mxCell><mxCell id="run_begin" value="&lt;b&gt;RUN_GPU_BEGIN&lt;/b&gt;&lt;br&gt;RNG Xorshift128 riêng cho từng cá thể (seed_r + s)&lt;br&gt;reset best đảo, gbest, bộ đếm trì trệ" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="55" y="265" width="195" height="110" as="geometry"/></mxCell><mxCell id="i1" value="&lt;b&gt;① RCRS-GRASP&lt;/b&gt;&lt;br&gt;α ~ U[0.10, 0.40] cho mỗi cá thể&lt;br&gt;chọn ngẫu nhiên trong RCL theo điểm chèn&lt;br&gt;ΔTD + 0.5·rc_pen + 0.3·rs_pen" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="285" y="270" width="226" height="100" as="geometry"/></mxCell><mxCell id="i2" value="&lt;b&gt;② SA warm-up nhẹ&lt;/b&gt;&lt;br&gt;T₀ = 100, ×0.85 đến T = 0.5&lt;br&gt;25 phép thử mỗi mức nhiệt&lt;br&gt;2-opt, Relocate (trong / giữa tuyến), Swap" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="529" y="270" width="226" height="100" as="geometry"/></mxCell><mxCell id="i3" value="&lt;b&gt;③ ROUTE_ELIMINATION&lt;/b&gt; (5 lượt)&lt;br&gt;gỡ tuyến ít khách nhất,&lt;br&gt;chèn lại khách sang tuyến khác&lt;br&gt;→ ép giảm NV" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="773" y="270" width="226" height="100" as="geometry"/></mxCell><mxCell id="i4" value="&lt;b&gt;④ DEEP_LOCAL_SEARCH&lt;/b&gt; (2 lượt)&lt;br&gt;2-opt · Relocate trong tuyến&lt;br&gt;Inter 2-opt* · Relocate giữa tuyến&lt;br&gt;Swap giữa tuyến" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1017" y="270" width="226" height="100" as="geometry"/></mxCell><mxCell id="bests0" value="UPDATE_ISLAND_BESTS → UPDATE_GLOBAL_BEST" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="405" width="300" height="46" as="geometry"/></mxCell><mxCell id="gen" value="gen ≤ iterMax ?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#111111;strokeWidth=1.2;fontSize=13;fontFamily=Times New Roman;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="470" y="480" width="180" height="90" as="geometry"/></mxCell><mxCell id="gen_p1" value="gen + 1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;align=right;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="500" width="160" height="22" as="geometry"/></mxCell><mxCell id="frame_title" value="&lt;b&gt;Parallel Hybrid SHO&amp;amp;WOA&lt;/b&gt;&lt;br&gt;kernel UPDATE_POPULATION · P thread song song" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;align=right;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="640" y="598" width="580" height="40" as="geometry"/></mxCell><mxCell id="isl1" value="Đảo 1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#FFFFFF;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="309" y="676" width="72" height="32" as="geometry"/></mxCell><mxCell id="isl2" value="Đảo 2" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#FFFFFF;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="395" y="676" width="72" height="32" as="geometry"/></mxCell><mxCell id="isl3" value="Đảo 3" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#FFFFFF;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="481" y="676" width="72" height="32" as="geometry"/></mxCell><mxCell id="isl4" value="Đảo 4" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#FFFFFF;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="567" y="676" width="72" height="32" as="geometry"/></mxCell><mxCell id="isl5" value="Đảo 5" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#FFFFFF;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="653" y="676" width="72" height="32" as="geometry"/></mxCell><mxCell id="isl6" value="Đảo 6" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#FFFFFF;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="739" y="676" width="72" height="32" as="geometry"/></mxCell><mxCell id="hyb" value="&lt;b&gt;UPDATE_POSITION_HYBRID(p)&lt;/b&gt;&lt;br&gt;tournament 3 trong đảo của p → peer · dẫn đường = best của đảo (thay global best)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="760" width="460" height="60" as="geometry"/></mxCell><mxCell id="phyb" value="rand &amp;lt; p_hybrid ?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#111111;strokeWidth=1.2;fontSize=13;fontFamily=Times New Roman;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="450" y="845" width="220" height="84" as="geometry"/></mxCell><mxCell id="phyb_note" value="&lt;i&gt;p_hybrid = max(0.15, 0.5·(1 − t))&lt;br&gt;t = (gen − 1) / iterMax&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;align=right;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="860" width="340" height="56" as="geometry"/></mxCell><mxCell id="sho" value="&lt;b&gt;UPDATE_SHO(p)&lt;/b&gt; · GuidedCrossover&lt;br&gt;chép 1–2 tuyến của best đảo; chèn rẻ nhất các khách còn lại (theo thứ tự p, rồi peer)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="960" width="400" height="66" as="geometry"/></mxCell><mxCell id="woa" value="&lt;b&gt;UPDATE_WOA(p)&lt;/b&gt; · A = 2a·r − a, a = 2 − 2t&lt;br&gt;|A| &amp;lt; 1: bao vây best đảo, đổi chỗ 2 khách&lt;br&gt;|A| ≥ 1: khám phá từ p, đảo đoạn 2-opt ngẫu nhiên" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="842" width="400" height="90" as="geometry"/></mxCell><mxCell id="feas" value="newP&lt;br&gt;khả thi ?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#111111;strokeWidth=1.2;fontSize=13;fontFamily=Times New Roman;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="465" y="1065" width="190" height="72" as="geometry"/></mxCell><mxCell id="keep" value="next[p] = p&lt;br&gt;(giữ nghiệm hiện tại)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="150" y="1076" width="240" height="50" as="geometry"/></mxCell><mxCell id="cost" value="ΔCost ≤ 0 ?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#111111;strokeWidth=1.2;fontSize=13;fontFamily=Times New Roman;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="460" y="1170" width="200" height="80" as="geometry"/></mxCell><mxCell id="sa" value="&lt;b&gt;SA Acceptance&lt;/b&gt;&lt;br&gt;next[p] = newP nếu rand &amp;lt; exp(−ΔCost / (T·|Cost(p)|)), ngược lại p; T = 1 − t" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="1175" width="400" height="70" as="geometry"/></mxCell><mxCell id="acc" value="&lt;b&gt;Accepted&lt;/b&gt;&lt;br&gt;next[p] = newP" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="440" y="1280" width="240" height="50" as="geometry"/></mxCell><mxCell id="pingpong" value="Hoán đổi ping-pong cur ↔ next (đổi con trỏ, zero-copy)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="1385" width="400" height="44" as="geometry"/></mxCell><mxCell id="ls" value="gen mod 25 = 0 ?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#111111;strokeWidth=1.2;fontSize=13;fontFamily=Times New Roman;fillColor=#E2F0D9;" vertex="1" parent="1"><mxGeometry x="460" y="1460" width="200" height="76" as="geometry"/></mxCell><mxCell id="lsb" value="&lt;b&gt;ROUTE_ELIMINATION&lt;/b&gt; (5 lượt) + &lt;b&gt;DEEP_LOCAL_SEARCH&lt;/b&gt; (2 lượt)&lt;br&gt;cho &lt;b&gt;toàn bộ P cá thể&lt;/b&gt; (paper: chỉ best toàn cục)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="1458" width="400" height="80" as="geometry"/></mxCell><mxCell id="mig" value="gen mod 20 = 0 ?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#111111;strokeWidth=1.2;fontSize=13;fontFamily=Times New Roman;fillColor=#E2F0D9;" vertex="1" parent="1"><mxGeometry x="460" y="1575" width="200" height="76" as="geometry"/></mxCell><mxCell id="migb" value="&lt;b&gt;RING_MIGRATION&lt;/b&gt; (khi số đảo &amp;gt; 1)&lt;br&gt;best đảo i thay cá thể tệ nhất của đảo i+1 (chỉ khi tốt hơn)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="1578" width="400" height="70" as="geometry"/></mxCell><mxCell id="bests1" value="UPDATE_ISLAND_BESTS → UPDATE_GLOBAL_BEST&lt;br&gt;ghi log (NV, TD) của gbest vào VRAM" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="1688" width="400" height="50" as="geometry"/></mxCell><mxCell id="stag" value="gbest không cải thiện&lt;br&gt;≥ 50 thế hệ ?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#111111;strokeWidth=1.2;fontSize=13;fontFamily=Times New Roman;fillColor=#E2F0D9;" vertex="1" parent="1"><mxGeometry x="430" y="1765" width="260" height="96" as="geometry"/></mxCell><mxCell id="div" value="&lt;b&gt;DIVERSIFY&lt;/b&gt; (ruin &amp;amp; recreate)&lt;br&gt;40% cá thể ngẫu nhiên: gỡ 20–40% khách, chèn lại rẻ nhất · reset bộ đếm" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="1778" width="400" height="70" as="geometry"/></mxCell><mxCell id="run_end" value="&lt;b&gt;RUN_GPU_END&lt;/b&gt;&lt;br&gt;cuda.synchronize() 1 lần mỗi run" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="75" y="1905" width="420" height="56" as="geometry"/></mxCell><mxCell id="decode" value="&lt;b&gt;CPU_DECODE&lt;/b&gt; (1 lần mỗi run)&lt;br&gt;copy gbest + log (NV, TD) về host → giải mã Solution → kiểm tra khả thi" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="75" y="2015" width="420" height="72" as="geometry"/></mxCell><mxCell id="upd_best" value="Cập nhật best_s qua các run&lt;br&gt;(NV ít hơn, hoặc cùng NV và Cost thấp hơn)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="545" y="2015" width="380" height="72" as="geometry"/></mxCell><mxCell id="plate_label" value="&lt;i&gt;Lặp cho mỗi run r = 1 … runs (mặc định 30)&lt;br&gt;seed_r = seed + r·100003&lt;br&gt;buffer VRAM dùng lại, không cấp phát lại&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;align=right;verticalAlign=middle;fontSize=12;fontColor=#404040;" vertex="1" parent="1"><mxGeometry x="945" y="2012" width="325" height="80" as="geometry"/></mxCell><mxCell id="best_out" value="&lt;b&gt;bestSolution&lt;/b&gt; (tốt nhất qua mọi run)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="545" y="2140" width="380" height="50" as="geometry"/></mxCell><mxCell id="end" value="Kết thúc" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=1.2;fontSize=14;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="695" y="2220" width="80" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
