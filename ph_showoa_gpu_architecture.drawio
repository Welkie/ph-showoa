ts"><mxPoint x="1010" y="1885"/><mxPoint x="1250" y="1885"/><mxPoint x="1250" y="525"/></Array></mxGeometry></mxCell><mxCell id="e_end_dec" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#111111;strokeWidth=1.2;fontSize=13;fontStyle=1;labelBackgroundColor=none;fontFamily=Times New Roman;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="run_end" target="decode"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_dec_best" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#111111;strokeWidth=1.2;fontSize=13;fontStyle=1;labelBackgroundColor=none;fontFamily=Times New Roman;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="decode" target="upd_best"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_best_out" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#111111;strokeWidth=1.2;fontSize=13;fontStyle=1;labelBackgroundColor=none;fontFamily=Times New Roman;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="upd_best" target="best_out"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_out_end" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#111111;strokeWidth=1.2;fontSize=13;fontStyle=1;labelBackgroundColor=none;fontFamily=Times New Roman;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="best_out" target="end"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="start" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=1.2;fontSize=14;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="50" y="70" width="80" height="44" as="geometry"/></mxCell><mxCell id="cpu_prep" value="&lt;b&gt;CPU_PREP&lt;/b&gt; (once for all runs)&lt;br&gt;Read instance; upload distance/time matrices, delivery/pickup demands, time windows to VRAM&lt;br&gt;Pre-allocate buffers: population cur / next / cand [P×R×L], island bests, gbest, scratch, RNG, log" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="45" width="560" height="92" as="geometry"/></mxCell><mxCell id="leg_new_sw" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;" vertex="1" parent="1"><mxGeometry x="800" y="52" width="34" height="18" as="geometry"/></mxCell><mxCell id="leg_new" value="New / changed vs. the PH-SHOWOA paper" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="842" y="48" width="430" height="26" as="geometry"/></mxCell><mxCell id="leg_old_sw" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="800" y="82" width="34" height="18" as="geometry"/></mxCell><mxCell id="leg_old" value="As in the paper (Alg. 1)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="842" y="78" width="430" height="26" as="geometry"/></mxCell><mxCell id="leg_cost" value="Cost = 2000·NV + TD (used for selection, acceptance and best tracking)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="800" y="108" width="470" height="26" as="geometry"/></mxCell><mxCell id="run_begin" value="&lt;b&gt;RUN_GPU_BEGIN&lt;/b&gt;&lt;br&gt;per-individual Xorshift128 RNG (seed_r + s)&lt;br&gt;reset island bests, gbest, stagnation counter" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="55" y="265" width="195" height="110" as="geometry"/></mxCell><mxCell id="i1" value="&lt;b&gt;① RCRS-GRASP&lt;/b&gt;&lt;br&gt;α ~ U[0.10, 0.40] per individual&lt;br&gt;random pick from the RCL, insertion score&lt;br&gt;ΔTD + 0.5·rc_pen + 0.3·rs_pen" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="285" y="270" width="226" height="100" as="geometry"/></mxCell><mxCell id="i2" value="&lt;b&gt;② Light SA warm-up&lt;/b&gt;&lt;br&gt;T₀ = 100, ×0.85 down to T = 0.5&lt;br&gt;25 trials per temperature&lt;br&gt;2-opt, Relocate (intra / inter), Swap" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="529" y="270" width="226" height="100" as="geometry"/></mxCell><mxCell id="i3" value="&lt;b&gt;③ ROUTE_ELIMINATION&lt;/b&gt; (5 passes)&lt;br&gt;remove the shortest route,&lt;br&gt;re-insert its customers elsewhere&lt;br&gt;→ reduce NV" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="773" y="270" width="226" height="100" as="geometry"/></mxCell><mxCell id="i4" value="&lt;b&gt;④ DEEP_LOCAL_SEARCH&lt;/b&gt; (2 passes)&lt;br&gt;2-opt · intra Relocate&lt;br&gt;Inter 2-opt* · inter Relocate&lt;br&gt;inter Swap" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1017" y="270" width="226" height="100" as="geometry"/></mxCell><mxCell id="bests0" value="UPDATE_ISLAND_BESTS → UPDATE_GLOBAL_BEST" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="405" width="300" height="46" as="geometry"/></mxCell><mxCell id="gen" value="gen ≤ iterMax ?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#111111;strokeWidth=1.2;fontSize=13;fontFamily=Times New Roman;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="470" y="480" width="180" height="90" as="geometry"/></mxCell><mxCell id="gen_p1" value="gen + 1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;align=right;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="500" width="160" height="22" as="geometry"/></mxCell><mxCell id="frame_title" value="&lt;b&gt;Parallel Hybrid SHO&amp;amp;WOA&lt;/b&gt;&lt;br&gt;kernel UPDATE_POPULATION · P threads in parallel" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;align=right;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="640" y="598" width="580" height="40" as="geometry"/></mxCell><mxCell id="isl1" value="Island 1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#FFFFFF;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="309" y="676" width="72" height="32" as="geometry"/></mxCell><mxCell id="isl2" value="Island 2" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#FFFFFF;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="395" y="676" width="72" height="32" as="geometry"/></mxCell><mxCell id="isl3" value="Island 3" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#FFFFFF;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="481" y="676" width="72" height="32" as="geometry"/></mxCell><mxCell id="isl4" value="Island 4" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#FFFFFF;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="567" y="676" width="72" height="32" as="geometry"/></mxCell><mxCell id="isl5" value="Island 5" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#FFFFFF;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="653" y="676" width="72" height="32" as="geometry"/></mxCell><mxCell id="isl6" value="Island 6" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#FFFFFF;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="739" y="676" width="72" height="32" as="geometry"/></mxCell><mxCell id="hyb" value="&lt;b&gt;UPDATE_POSITION_HYBRID(p)&lt;/b&gt;&lt;br&gt;tournament of 3 inside p's island → peer · guide = island best (not the global best)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="760" width="460" height="60" as="geometry"/></mxCell><mxCell id="phyb" value="rand &amp;lt; p_hybrid ?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#111111;strokeWidth=1.2;fontSize=13;fontFamily=Times New Roman;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="450" y="845" width="220" height="84" as="geometry"/></mxCell><mxCell id="phyb_note" value="&lt;i&gt;p_hybrid = max(0.15, 0.5·(1 − t))&lt;br&gt;t = (gen − 1) / iterMax&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;align=right;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="860" width="340" height="56" as="geometry"/></mxCell><mxCell id="sho" value="&lt;b&gt;UPDATE_SHO(p)&lt;/b&gt; · GuidedCrossover&lt;br&gt;copy 1–2 routes of the island best; cheapest-insert the remaining customers (order: p, then peer)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="960" width="400" height="66" as="geometry"/></mxCell><mxCell id="woa" value="&lt;b&gt;UPDATE_WOA(p)&lt;/b&gt; · A = 2a·r − a, a = 2 − 2t&lt;br&gt;|A| &amp;lt; 1: encircle the island best, swap 2 customers&lt;br&gt;|A| ≥ 1: explore from p, random 2-opt reversal" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="842" width="400" height="90" as="geometry"/></mxCell><mxCell id="feas" value="newP&lt;br&gt;feasible ?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#111111;strokeWidth=1.2;fontSize=13;fontFamily=Times New Roman;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="465" y="1065" width="190" height="72" as="geometry"/></mxCell><mxCell id="keep" value="next[p] = p&lt;br&gt;(keep current)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="150" y="1076" width="240" height="50" as="geometry"/></mxCell><mxCell id="cost" value="ΔCost ≤ 0 ?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#111111;strokeWidth=1.2;fontSize=13;fontFamily=Times New Roman;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="460" y="1170" width="200" height="80" as="geometry"/></mxCell><mxCell id="sa" value="&lt;b&gt;SA Acceptance&lt;/b&gt;&lt;br&gt;next[p] = newP if rand &amp;lt; exp(−ΔCost / (T·|Cost(p)|)), else p; T = 1 − t" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="1175" width="400" height="70" as="geometry"/></mxCell><mxCell id="acc" value="&lt;b&gt;Accepted&lt;/b&gt;&lt;br&gt;next[p] = newP" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="440" y="1280" width="240" height="50" as="geometry"/></mxCell><mxCell id="pingpong" value="Ping-pong swap cur ↔ next (pointer swap, zero-copy)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="1385" width="400" height="44" as="geometry"/></mxCell><mxCell id="ls" value="gen mod 25 = 0 ?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#111111;strokeWidth=1.2;fontSize=13;fontFamily=Times New Roman;fillColor=#E2F0D9;" vertex="1" parent="1"><mxGeometry x="460" y="1460" width="200" height="76" as="geometry"/></mxCell><mxCell id="lsb" value="&lt;b&gt;ROUTE_ELIMINATION&lt;/b&gt; (5 passes) + &lt;b&gt;DEEP_LOCAL_SEARCH&lt;/b&gt; (2 passes)&lt;br&gt;on &lt;b&gt;all P individuals&lt;/b&gt; (paper: global best only)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="1458" width="400" height="80" as="geometry"/></mxCell><mxCell id="mig" value="gen mod 20 = 0 ?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#111111;strokeWidth=1.2;fontSize=13;fontFamily=Times New Roman;fillColor=#E2F0D9;" vertex="1" parent="1"><mxGeometry x="460" y="1575" width="200" height="76" as="geometry"/></mxCell><mxCell id="migb" value="&lt;b&gt;RING_MIGRATION&lt;/b&gt; (if islands &amp;gt; 1)&lt;br&gt;best of island i replaces the worst of island i+1 (only if better)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="1578" width="400" height="70" as="geometry"/></mxCell><mxCell id="bests1" value="UPDATE_ISLAND_BESTS → UPDATE_GLOBAL_BEST&lt;br&gt;log (NV, TD) of gbest to VRAM" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="1688" width="400" height="50" as="geometry"/></mxCell><mxCell id="stag" value="gbest not improved&lt;br&gt;for ≥ 50 generations ?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#111111;strokeWidth=1.2;fontSize=13;fontFamily=Times New Roman;fillColor=#E2F0D9;" vertex="1" parent="1"><mxGeometry x="430" y="1765" width="260" height="96" as="geometry"/></mxCell><mxCell id="div" value="&lt;b&gt;DIVERSIFY&lt;/b&gt; (ruin &amp;amp; recreate)&lt;br&gt;40% random individuals: remove 20–40% of customers, cheapest re-insertion · reset counter" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="1778" width="400" height="70" as="geometry"/></mxCell><mxCell id="run_end" value="&lt;b&gt;RUN_GPU_END&lt;/b&gt;&lt;br&gt;cuda.synchronize() once per run" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="75" y="1905" width="420" height="56" as="geometry"/></mxCell><mxCell id="decode" value="&lt;b&gt;CPU_DECODE&lt;/b&gt; (once per run)&lt;br&gt;copy gbest + log (NV, TD) to host → decode Solution → feasibility check" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#E2F0D9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="75" y="2015" width="420" height="72" as="geometry"/></mxCell><mxCell id="upd_best" value="Update best_s across runs&lt;br&gt;(fewer NV, or same NV and lower Cost)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Roman;fillColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="545" y="2015" width="380" height="72" as="geometry"/></mxCell><mxCell id="plate_label" value="&lt;i&gt;Repeated for each run r = 1 … runs (default 30)&lt;br&gt;seed_r = seed + r·100003&lt;br&gt;VRAM buffers reused, no re-allocation&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;align=right;verticalAlign=middle;fontSize=12;fontColor=#404040;" vertex="1" parent="1"><mxGeometry x="945" y="2012" width="325" height="80" as="geometry"/></mxCell><mxCell id="best_out" value="&lt;b&gt;bestSolution&lt;/b&gt; (best over all runs)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#5AA344;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontFamily=Times New Ro